# Get a key at https://aistudio.google.com/apikey
# Copy this file to .env.local and fill it in. Never commit .env.local.
GEMINI_API_KEY=

# Optional. Without it, GitHub allows 10 searches a minute (each marking uses 4).
# A token with no scopes raises that to 30: https://github.com/settings/tokens
GITHUB_TOKEN=

# Optional. Saves evaluations so get_evaluation and ?e=<id> links survive
# restarts and work across serverless instances. Without them, evaluations
# are kept in memory. Free database: https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
